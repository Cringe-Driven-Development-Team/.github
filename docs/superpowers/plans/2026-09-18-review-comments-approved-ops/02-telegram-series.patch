           ACTOR:     ${{ github.actor }}
@@ -62,17 +71,18 @@ jobs:
 
           esc () { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }
 
-          # 1 коммит / 2 коммита / 5 коммитов
+          # plural 3 коммит коммита коммитов → «коммита»
           plural () {
             case "$(($1 % 100))" in
