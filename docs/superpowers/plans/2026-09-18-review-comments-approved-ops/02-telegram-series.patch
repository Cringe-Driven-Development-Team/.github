@@ -87,6 +97,39 @@ jobs:
             fi
           }
 
+          # серия ревью REVIEW_BY — идущие подряд с конца отправленные ревью с паузами короче 3 минут
+          # (столько ждём перед отправкой, см. REVIEW_WAIT). NOTES — сколько в серии комментариев:
+          # inline плюс ревью с общим текстом; пусто — API недоступен. FIRST_URL — первое ревью серии
+          series () {
+            NOTES=""
+            FIRST_URL="$REVIEW_URL"
+            ERR="${RUNNER_TEMP:-/tmp}/gh-series.err"
+            if ! LIST=$(gh api "repos/$REPO/pulls/$NUMBER/reviews" --paginate \
+                --jq ".[] | select(.user.login == \"$REVIEW_BY\" and .state != \"PENDING\") | [.id, .submitted_at, ((.body // \"\") != \"\"), .html_url] | @tsv" 2>"$ERR"); then
+              echo "::warning::Не прочитал ревью PR, сообщение без числа комментариев: $(head -c 200 "$ERR")"
+              return 0
+            fi
+            SERIES=$(printf '%s\n' "$LIST" | jq -Rsc '
+              [gsub("\r"; "") | split("\n")[] | select(length > 0) | split("\t")
+                | {id: .[0], at: (.[1] | fromdateiso8601), body: (.[2] == "true"), url: .[3]}]
+              | sort_by(.at) | reverse
+              | reduce .[] as $x ({s: [], open: true};
+                  if .open and ((.s | length) == 0 or (.s[-1].at - $x.at) < 180)
+                  then .s += [$x] else .open = false end)
+              | .s | reverse')
+            [ "$(printf '%s' "$SERIES" | jq 'length')" -gt 0 ] || return 0
+            FIRST_URL=$(printf '%s' "$SERIES" | jq -r '.[0].url')
+            if ! INLINE=$(gh api "repos/$REPO/pulls/$NUMBER/comments" --paginate \
+                --jq '.[].pull_request_review_id' 2>"$ERR"); then
+              echo "::warning::Не прочитал комментарии PR, сообщение без их числа: $(head -c 200 "$ERR")"
+              return 0
+            fi
+            NOTES=$(jq -n --argjson s "$SERIES" --arg inline "$INLINE" '
+              ($s | map(.id)) as $ids
+              | ([$inline | gsub("\r"; "") | split("\n")[] | select(. as $i | $ids | index($i))] | length)
+                + ($s | map(select(.body)) | length)')
+          }
+
           case "$EVENT:$ACTION" in
             push:)
               # коммиты, которые уже были в других ветках (подтянутые из main), — не новость
@@ -95,9 +138,9 @@ jobs:
               # создание и удаление ветки, пуш тега — событие есть, коммитов нет
               [ "$COUNT" -eq 0 ] && exit 0
               if [ "$FORCED" = "true" ]; then
-                HEAD="⚠️ $COUNT $(plural "$COUNT") (force-push)"
+                HEAD="⚠️ $COUNT $(commits "$COUNT") (force-push)"
               else
-                HEAD="⚒️ $COUNT $(plural "$COUNT")"
+                HEAD="⚒️ $COUNT $(commits "$COUNT")"
               fi ;;
             issues:opened)   HEAD="🆕 Новая задача" ;;
             issues:closed)   HEAD="✅ Задача закрыта" ;;
@@ -147,7 +190,7 @@ jobs:
                   if [ "$AHEAD" -eq 0 ]; then
                     AFTER="$AFTER: новых коммитов нет"
                   else
-                    AFTER="$AFTER: $AHEAD $(plural "$AHEAD")"
+                    AFTER="$AFTER: $AHEAD $(commits "$AHEAD")"
                     MARKUP=$(printf '{"inline_keyboard":[[{"text":"Что изменилось","url":"https://github.com/%s/pull/%s/files/%s..%s"}]]}' \
                       "$REPO" "$NUMBER" "$SHA" "$HEAD_SHA")
                   fi
@@ -161,11 +204,24 @@ jobs:
               fi ;;
             pull_request_review:submitted)
               DEST="$RTOPIC"
+              # ответы автора в ветках обсуждения и ревью ботов — не новость
+              [ "$REVIEW_BY" = "$PR_AUTHOR" ] && exit 0
+              [ "$REVIEW_BY_TYPE" = "Bot" ] && exit 0
               case "$REVIEW" in
-                approved)          HEAD="👍 Апрув";            WHO="$PR_AUTHOR" ;;
-                changes_requested) HEAD="✋ Запрошены правки";  WHO="$PR_AUTHOR" ;;
-                *)                 exit 0 ;;
-              esac ;;
+                approved)          HEAD="👍 Апрув" ;;
+                changes_requested) HEAD="✋ Запрошены правки" ;;
+                commented)
+                  # каждый одиночный комментарий — отдельное событие: ждём, пока ревьювер затихнет;
+                  # его следующий комментарий отменит этот запуск (concurrency у job)
+                  sleep "${REVIEW_WAIT:-180}"
+                  HEAD="💬 Комментарии к PR" ;;
+                *) exit 0 ;;
+              esac
+              KIND=reviewed
+              series
+              if [ -n "$FIRST_URL" ] && { [ "$REVIEW" = "commented" ] || [ "${NOTES:-0}" -gt 0 ]; }; then
+                MARKUP=$(printf '{"inline_keyboard":[[{"text":"Открыть ревью","url":"%s"}]]}' "$FIRST_URL")
+              fi ;;
             *) exit 0 ;;
           esac
 
@@ -259,6 +315,12 @@ jobs:
                 requested)
                   LINE=$(asked)
                   [ -n "$AFTER" ] && LINE=$(printf '%s\n%s' "$LINE" "$AFTER") ;;
+                # ревью оставлено: действовать автору — пингуем его, ревьювер текстом
+                reviewed)
+                  LINE="автор: $(mention "$PR_AUTHOR") · ревьювер: $(esc "$REVIEW_BY")"
+                  if [ "${NOTES:-0}" -gt 0 ]; then
+                    LINE=$(printf '%s\n%s %s' "$LINE" "$NOTES" "$(plural "$NOTES" комментарий комментария комментариев)")
+                  fi ;;
                 *)         LINE=$(mention "$WHO") ;;
               esac
             fi
