           REVIEW:    ${{ github.event.review.state }}
+          REVIEW_BY: ${{ github.event.review.user.login }}
+          REVIEW_BY_TYPE: ${{ github.event.review.user.type }}
+          REVIEW_URL: ${{ github.event.review.html_url }}
           REVIEWER:  ${{ github.event.requested_reviewer.login }}
