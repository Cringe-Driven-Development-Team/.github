+    # Остальные события получают свою группу и друг друга не отменяют
+    concurrency:
+      group: ${{ github.event_name == 'pull_request_review' && format('tg-review-{0}-{1}-{2}', github.repository, github.event.pull_request.number, github.event.review.user.login) || format('tg-{0}', github.run_id) }}
+      cancel-in-progress: true
     steps:
       - name: Отправить сообщение
         env:
@@ -23,6 +29,9 @@ jobs:
           DRAFT:     ${{ github.event.pull_request.draft }}
