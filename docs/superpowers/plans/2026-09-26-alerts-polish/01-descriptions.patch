+          # quote <текст> — описание или комментарий из GitHub → HTML Telegram: без HTML-тегов и комментариев,
+          # картинки ссылками, markdown — разметкой, не длиннее 700 символов. Код (`…`, ```…```) не трогаем.
+          # -Mutf8: без него «…» в коде — три байта, и в сообщение попадает «â¦»
+          quote () {
+            printf '%s' "$1" | perl -CS -Mutf8 -0777 -pe '
+              my $code = qr/```.*?```|`[^`\n]+`/s;
+              s/<!--.*?-->//gs; s/\r//g;
+              s{($code)|<img\b[^>]*?\bsrc="([^"]+)"[^>]*>}{$1 // "[🖼 картинка]($2)"}gie;
+              s{($code)|!\[[^\]\n]*\]\(([^)\s]+)[^)\n]*\)}{$1 // "[🖼 картинка]($2)"}ge;
+              s{($code)|<br\s*/?>|</(?:p|div|summary|details|li|tr|h\d)>}{$1 // "\n"}gie;
+              s{($code)|</?[A-Za-z][^<>]*>}{$1 // ""}ge;
+              s/[ \t]+$//gm; s/\n{3,}/\n\n/g; s/^\s+|\s+$//g;
+              $_ = substr($_, 0, 700) . "…" if length > 700;
+              s/&/&amp;/g; s/</&lt;/g; s/>/&gt;/g;
+              my @k;
+              my $fences = () = /^```/mg;
+              s/\A(.*)^```[^\n]*\n?/$1/sm if $fences % 2;
+              s{^```[^\n]*\n(.*?)\n?^```[ \t]*$}{push @k, "<pre>$1</pre>"; "\x00$#k\x00"}gems;
+              s{`([^`\n]+)`}{push @k, "<code>$1</code>"; "\x00$#k\x00"}ge;
+              s{^#{1,6}[ \t]+(.+?)[ \t#]*$}{<b>$1</b>}gm;
+              s{\*\*(?=\S)(.+?)(?<=\S)\*\*}{<b>$1</b>}g;
+              s{~~(?=\S)(.+?)(?<=\S)~~}{<s>$1</s>}g;
+              s{\[([^\]\n]+)\]\((https?://[^)\s"]+)\)}{<a href="$2">$1</a>}g;
+              s/^([ \t]*)[-*+][ \t]+\[ \][ \t]+/$1☐ /gm;
+              s/^([ \t]*)[-*+][ \t]+\[[xX]\][ \t]+/$1☑ /gm;
+              s/^([ \t]*)[-*+][ \t]+/$1• /gm;
+              s/\x00(\d+)\x00/$k[$1]/g;
+            '
+          }
